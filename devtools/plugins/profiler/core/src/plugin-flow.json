{
  "id": "player-ui-profiler-devtools-plugin",
  "views": [
    {
      "id": "Profile",
      "type": "stacked-view",
      "header": {
        "asset": {
          "id": "Profile-header",
          "type": "navigation",
          "values": [
            {
              "asset": {
                "id": "Profile-header-values-0",
                "type": "action",
                "value": "Profile",
                "label": {
                  "asset": {
                    "id": "Profile-header-values-0-label",
                    "type": "text",
                    "value": "Profile"
                  }
                }
              }
            }
          ]
        }
      },
      "main": {
        "asset": {
          "id": "Profile-main",
          "type": "object-inspector",
          "binding": "durations",
          "label": {
            "asset": {
              "id": "Profile-main-label",
              "type": "text",
              "value": "Profile"
            }
          }
        }
      },
      "footer": {
        "asset": {
          "id": "Editor-header-values-0",
          "type": "action",
          "exp": "conditional({{profiling}} === true, publish('stop-profiling'), publish('start-profiling'))",
          "label": {
            "asset": {
              "id": "Editor-header-values-0-label",
              "type": "text",
              "value": "@[conditional({{profiling}} === true, 'Stop', 'Start')]@"
            }
          }
        }
      }
    }
  ],
  "navigation": {
    "BEGIN": "Plugin",
    "Plugin": {
      "startState": "PROFILE",
      "PROFILE": {
        "state_type": "VIEW",
        "ref": "Profile",
        "transitions": {
          "Profile": "PROFILE"
        }
      }
    }
  },
